# Fluxer Bot Token (格式: <application_id>.<secret>)
FLUXER_BOT_TOKEN=your_bot_token_here

# 允许执行管理员指令的 Snowflake 用户 ID 列表，多个 ID 用半角逗号分隔
ADMIN_USER_IDS=123456789012345678,234567890123456789

# Fluxer API 基础地址（可选，官方默认为 https://api.fluxer.app，若自托管可配置对应域名）
FLUXER_API_BASE=https://api.fluxer.app

# 配置文件存储路径（可选，默认为 data/config.json）
CONFIG_PATH=data/config.json
